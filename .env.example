# Supabase Auth and learning progress (optional for local demo mode)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Legacy anon key is also accepted if your project has not issued publishable keys.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Gemini API (server-side only; used by the interview coach & live evaluation)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API (server-side only; used by the AI Resume Analyzer powered by LLaMA 3.3 70B)
GROQ_API_KEY=your_groq_api_key_here

# ElevenLabs API key for voice narration (optional, falls back to web speech)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
